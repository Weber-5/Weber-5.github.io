---
/**
 * A generative project cover, drawn from the project's slug: a project without
 * artwork still gets a stable image of its own, in the site's ink language.
 *
 * Colour follows the site's rule for pictures: indigo only as the tint of
 * distance. Farther elements carry indigo-tinted ink, nearer ones plain ink, and
 * nothing glows.
 */
import { rng, ridge, areaPath, linePath } from '../lib/ink';

interface Props {
  seed: string;
  /** 0 ranges, 1 signal, 2 traces. Omit to derive it from the seed. */
  variant?: number;
}

const { seed, variant: forced } = Astro.props;
const rand = rng(seed);
const variant = forced ?? Math.floor(rand() * 3);
const uid = seed.replace(/[^a-z0-9]/gi, '');
const W = 640;
const H = 400;

// Ranges: a moon left as paper (烘云托月), far hills tinted, near hills in ink.
const moon = { x: W * (0.58 + rand() * 0.22), y: 104, r: 34 };
const ranges = [0, 1, 2, 3, 4].map((i) => ({
  points: ridge(rand, { width: W, base: 170 + i * 52, amp: 38 - i * 3, steps: 56 }),
  tone: 0.12 + i * 0.13,
  far: i < 2,
}));

// Signal: stacked traces like distant ridges; the one being read is drawn in full ink.
const signals = Array.from({ length: 22 }, (_, i) => {
  const base = 66 + i * 13;
  const points: [number, number][] = [];
  const shift = rand() * 6;
  for (let s = 0; s <= 72; s++) {
    const u = s / 72;
    const envelope = Math.exp(-(((u - 0.56) / 0.2) ** 2));
    const y = Math.sin(u * 22 + shift) * 7 + Math.sin(u * 53 + shift * 2) * 4;
    points.push([u * W, base - envelope * Math.abs(y) * (1.2 + (i % 5) * 0.6)]);
  }
  return points;
});
const READ = 13;

// Traces: a circuit seen as an ink drawing; one path is inked darker than the rest.
const traces = Array.from({ length: 11 }, (_, i) => {
  const y0 = 30 + i * 34;
  const x1 = 90 + rand() * 170;
  const dy = (rand() - 0.5) * 120;
  const x2 = x1 + Math.abs(dy);
  const y1 = Math.min(H - 24, Math.max(24, y0 + dy));
  const x3 = x2 + 90 + rand() * 170;
  return { d: `M0 ${y0}H${x1.toFixed(0)}L${x2.toFixed(0)} ${y1.toFixed(0)}H${x3.toFixed(0)}`, x: x3, y: y1 };
});
const accent = Math.floor(rand() * traces.length);
---

<svg class="cover" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id={`w-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--ink)" stop-opacity="0.5"></stop>
      <stop offset="0.7" stop-color="var(--ink)" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id={`f-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--ink-far)" stop-opacity="0.5"></stop>
      <stop offset="0.7" stop-color="var(--ink-far)" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id={`s-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--ink-far)" stop-opacity="0.16"></stop>
      <stop offset="0.6" stop-color="var(--ink-far)" stop-opacity="0"></stop>
    </linearGradient>
    <radialGradient id={`h-${uid}`} cx={moon.x} cy={moon.y} r="110" gradientUnits="userSpaceOnUse">
      <stop offset={moon.r / 110} stop-color="var(--ink-far)" stop-opacity="0.22"></stop>
      <stop offset="0.5" stop-color="var(--ink-far)" stop-opacity="0.08"></stop>
      <stop offset="1" stop-color="var(--ink-far)" stop-opacity="0"></stop>
    </radialGradient>
    <mask id={`m-${uid}`} maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
      <rect width={W} height={H} fill="#fff"></rect>
      <circle cx={moon.x} cy={moon.y} r={moon.r} fill="#000"></circle>
    </mask>
  </defs>
  <rect width={W} height={H} fill="var(--paper-2)"></rect>

  {variant === 0 && (
    <g>
      <g mask={`url(#m-${uid})`}>
        <rect width={W} height={H} fill={`url(#s-${uid})`}></rect>
        <rect width={W} height={H} fill={`url(#h-${uid})`}></rect>
      </g>
      <circle class="moon" cx={moon.x} cy={moon.y} r={moon.r}></circle>
      {ranges.map((r) => (
        <g>
          <path d={areaPath(r.points, H)} fill="var(--paper-2)" opacity="0.5"></path>
          <path d={areaPath(r.points, H)} fill={r.far ? `url(#f-${uid})` : `url(#w-${uid})`} opacity={r.tone}></path>
          <path d={linePath(r.points)} stroke={r.far ? 'var(--ink-far)' : 'var(--ink)'} stroke-opacity={r.tone * 0.9}></path>
        </g>
      ))}
    </g>
  )}

  {variant === 1 && (
    <g>
      {signals.map((points, i) => (
        <path
          d={linePath(points)}
          stroke={i < 8 ? 'var(--ink-far)' : 'var(--ink)'}
          stroke-opacity={i === READ ? 0.85 : 0.1 + (i / signals.length) * 0.3}
          stroke-width={i === READ ? 1.3 : 0.9}
        ></path>
      ))}
    </g>
  )}

  {variant === 2 && (
    <g stroke-linejoin="round">
      {traces.map((t, i) => (
        <g>
          <path
            d={t.d}
            stroke={i < 4 ? 'var(--ink-far)' : 'var(--ink)'}
            stroke-opacity={i === accent ? 0.85 : 0.24}
            stroke-width={i === accent ? 1.4 : 1}
          ></path>
          <circle
            cx={t.x}
            cy={t.y}
            r={i === accent ? 4.5 : 3.5}
            fill={i === accent ? 'var(--ink)' : 'var(--paper-2)'}
            fill-opacity={i === accent ? 0.85 : 1}
            stroke="var(--ink)"
            stroke-opacity={i === accent ? 0 : 0.4}
          ></circle>
        </g>
      ))}
    </g>
  )}
</svg>

<style>
  .cover { width: 100%; height: 100%; }
  .moon { fill: light-dark(transparent, rgb(222 227 235 / 0.7)); }
</style>
