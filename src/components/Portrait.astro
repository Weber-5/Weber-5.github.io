---
import { rng, ridge, areaPath, linePath } from '../lib/ink';

interface Props {
  src?: string;
  alt: string;
  caption: string;
  coordinates?: string;
}

const { src, alt, caption, coordinates } = Astro.props;

/*
 * With no photo set, the arch frames an ink landscape instead.
 *
 * The moon is not painted. Following the old technique of 烘云托月 ("wash the
 * clouds to hold up the moon"), the sky is washed with ink and the moon is the
 * paper left untouched, its edge darkest where the wash meets it. Distant ranges
 * carry indigo mixed into the ink, as far hills do in ink painting; near ranges
 * are plain ink. There is no colour that is only decoration.
 */
const MOON = { x: 262, y: 148, r: 50 };
const rand = rng('moon-gate-3');
const ranges = [
  { base: 268, amp: 30, tone: 0.24, line: 0.2, far: true },
  { base: 318, amp: 36, tone: 0.36, line: 0.26, far: true },
  { base: 372, amp: 40, tone: 0.52, line: 0.34, far: false },
  { base: 428, amp: 40, tone: 0.76, line: 0.5, far: false },
  { base: 482, amp: 34, tone: 1, line: 0.7, far: false },
].map((r) => ({ ...r, points: ridge(rand, { width: 400, base: r.base, amp: r.amp, steps: 84, octaves: 5, sharp: true }) }));
---

<figure class="portrait">
  <div class="stage">
    <div class="gate">
      {src ? (
        <img src={src} alt={alt} width="800" height="1000" fetchpriority="high" />
      ) : (
        <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" role="img" aria-label={caption}>
          <defs>
            <linearGradient id="p-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--ink-far)" stop-opacity="0.11"></stop>
              <stop offset="0.45" stop-color="var(--ink-far)" stop-opacity="0.035"></stop>
              <stop offset="0.7" stop-color="var(--ink-far)" stop-opacity="0"></stop>
            </linearGradient>
            <radialGradient id="p-halo" cx={MOON.x} cy={MOON.y} r="175" gradientUnits="userSpaceOnUse">
              <stop offset={MOON.r / 175} stop-color="var(--ink-far)" stop-opacity="0.15"></stop>
              <stop offset="0.42" stop-color="var(--ink-far)" stop-opacity="0.075"></stop>
              <stop offset="0.7" stop-color="var(--ink-far)" stop-opacity="0.02"></stop>
              <stop offset="1" stop-color="var(--ink-far)" stop-opacity="0"></stop>
            </radialGradient>
            <linearGradient id="p-wash" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--ink)" stop-opacity="0.62"></stop>
              <stop offset="0.3" stop-color="var(--ink)" stop-opacity="0.2"></stop>
              <stop offset="0.72" stop-color="var(--ink)" stop-opacity="0"></stop>
            </linearGradient>
            <linearGradient id="p-wash-far" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--ink-far)" stop-opacity="0.62"></stop>
              <stop offset="0.3" stop-color="var(--ink-far)" stop-opacity="0.2"></stop>
              <stop offset="0.72" stop-color="var(--ink-far)" stop-opacity="0"></stop>
            </linearGradient>
            <filter id="p-edge" x="-30%" y="-30%" width="160%" height="160%">
              <feGaussianBlur stdDeviation="1.6"></feGaussianBlur>
            </filter>
            <mask id="p-moon" maskUnits="userSpaceOnUse" x="0" y="0" width="400" height="500">
              <rect width="400" height="500" fill="#fff"></rect>
              <circle cx={MOON.x} cy={MOON.y} r={MOON.r} fill="#000" filter="url(#p-edge)"></circle>
            </mask>
          </defs>

          <!-- The wash, with the moon left as paper. -->
          <g mask="url(#p-moon)">
            <rect width="400" height="500" fill="url(#p-sky)"></rect>
            <rect width="400" height="500" fill="url(#p-halo)"></rect>
          </g>
          <!-- At night the paper is dark, so the moon is lit instead of left blank. -->
          <circle class="moon" cx={MOON.x} cy={MOON.y} r={MOON.r} filter="url(#p-edge)"></circle>

          {ranges.map((r) => (
            <g>
              <path d={areaPath(r.points, 500)} fill="var(--surface-2)" opacity="0.55"></path>
              <path d={areaPath(r.points, 500)} fill={r.far ? 'url(#p-wash-far)' : 'url(#p-wash)'} opacity={r.tone}></path>
              <path d={linePath(r.points)} fill="none" stroke={r.far ? 'var(--ink-far)' : 'var(--ink)'} stroke-opacity={r.line} stroke-width="0.9"></path>
            </g>
          ))}
        </svg>
      )}
    </div>
    <svg class="frame" viewBox="0 0 400 500" fill="none" aria-hidden="true">
      <path d="M-10 500V200a210 210 0 0 1 420 0v300" stroke="var(--line-2)" vector-effect="non-scaling-stroke"></path>
      <path d="M-30 500h20M410 500h20" stroke="var(--ink-4)" vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>
  <figcaption class="label">
    <span>{caption}</span>
    {coordinates && <span>{coordinates}</span>}
  </figcaption>
</figure>

<style>
  .portrait {
    position: relative;
    width: min(100%, 372px);
    margin-inline: auto;
    animation: gate-in 1.3s var(--ease) 0.2s both;
  }
  @keyframes gate-in {
    from { opacity: 0; transform: translateY(18px); }
  }
  .stage { position: relative; }
  .gate {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 999px 999px 3px 3px;
    background: linear-gradient(var(--surface), var(--paper-2));
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-3);
  }
  .gate img, .gate svg { width: 100%; height: 100%; object-fit: cover; }
  /* By day the moon is untouched paper; at night it is the one lit thing. */
  .moon { fill: light-dark(transparent, rgb(214 221 232 / 0.8)); }
  .frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 16px;
    font-size: 0.6875rem;
  }
</style>
