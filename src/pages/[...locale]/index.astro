---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Portrait from '../../components/Portrait.astro';
import SectionHead from '../../components/SectionHead.astro';
import PublicationRow from '../../components/PublicationRow.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import NoteRow from '../../components/NoteRow.astro';
import { href, localeParams, tr, useT, type Lang } from '../../i18n';
import { getProfile, getPublications } from '../../lib/data';
import { buildGraph, graphStats } from '../../lib/graph';
import { getVault } from '../../lib/vault';

export const getStaticPaths = localeParams;

const lang = Astro.props.lang as Lang;
const t = useT(lang);
const profile = getProfile();
const name = tr(profile.name, lang);

const papers = getPublications().filter((p) => p.selected).slice(0, 4);
const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const graph = await buildGraph();
const stats = graphStats(graph);
const recent = getVault().notes.slice(0, 4);

const crumbOf = (domain: string, field?: string) => {
  const d = graph.domains.find((x) => x.id === domain);
  const f = d?.fields.find((x) => x.id === field);
  return (f ?? d)?.name[lang] ?? '';
};

const taxonomy = graph.domains.map((d) => ({
  name: d.name[lang],
  fields: d.fields.map((f) => f.name[lang]).join(' · '),
}));

const quickLinks = [
  { key: 'link.github', icon: 'github', url: profile.links.github },
  { key: 'link.scholar', icon: 'scholar', url: profile.links.scholar },
  { key: 'link.email', icon: 'mail', url: profile.links.email && `mailto:${profile.links.email}` },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  url: Astro.site?.href,
  jobTitle: tr(profile.role, lang),
  affiliation: { '@type': 'Organization', name: tr(profile.affiliation, lang) },
  sameAs: [profile.links.github, profile.links.scholar, profile.links.orcid, profile.links.linkedin].filter(Boolean),
};
---

<Base lang={lang} type="profile" jsonLd={jsonLd}>
  <section class="hero">
    <div class="landscape" data-shanshui aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="label eyebrow"><span class="tick" aria-hidden="true"></span>{t('home.eyebrow')}</p>
        <h1 aria-label={name}>
          {[...name].map((ch, i) => <span aria-hidden="true" style={`--i:${i}`}>{ch}</span>)}
        </h1>
        <p class="role">
          <strong>{tr(profile.role, lang)}</strong>
          <span>{tr(profile.affiliation, lang)}</span>
        </p>
        <p class="tagline">{tr(profile.tagline, lang)}</p>
        <p class="intro">{tr(profile.intro, lang)}</p>
        <div class="actions">
          <a class="btn btn-primary" href={href('/cv/', lang)}>
            <Icon name="doc" />
            {t('link.cv')}
          </a>
          {quickLinks.map((link) =>
            link.url ? (
              <a class="btn" href={link.url} rel="me noopener">
                <Icon name={link.icon} />
                {t(link.key)}
              </a>
            ) : (
              <span class="btn" aria-disabled="true" data-tip={t('link.pending')}>
                <Icon name={link.icon} />
                {t(link.key)}
              </span>
            ),
          )}
        </div>
      </div>
      <Portrait
        src={profile.portrait || undefined}
        alt={name}
        caption={`${t('home.fig')} · ${t('home.portrait')}`}
        coordinates={profile.coordinates}
      />
    </div>
    <div class="cue wrap" aria-hidden="true">
      <span class="cue-line"><span class="cue-dot"></span></span>
      <span class="label">{t('home.scroll')}</span>
    </div>
  </section>

  <section class="section dossier wrap">
    <div class="interests">
      <p class="label" data-reveal>{t('home.interests')}</p>
      <ol>
        {profile.interests.map((item, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="label num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2>{tr(item.title, lang)}</h2>
              <p>{tr(item.note, lang)}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <blockquote class="philosophy" data-reveal>
      <p class="label">{t('home.philosophy')}</p>
      <p class="statement">{tr(profile.philosophy, lang)}</p>
    </blockquote>
  </section>

  <section class="section wrap">
    <SectionHead
      index="01"
      title={t('home.publications')}
      link={{ href: href('/research/', lang), label: t('home.publications.all') }}
    />
    <div>
      {papers.map((paper, i) => <PublicationRow paper={paper} lang={lang} i={i} />)}
    </div>
  </section>

  <section class="section wrap">
    <SectionHead
      index="02"
      title={t('home.projects')}
      link={{ href: href('/projects/', lang), label: t('home.projects.all') }}
    />
    <div class="project-grid">
      {projects.map((project, i) => (
        <ProjectCard project={project} lang={lang} i={i} variant={i} />
      ))}
    </div>
  </section>

  <section class="graph-band ink-panel" aria-labelledby="graph-preview-title">
    <canvas class="band-canvas" data-graph-preview data-lang={lang} role="img" aria-label={t('graph.lead')}></canvas>
    <div class="wrap band-grid">
      <div class="band-copy" data-band-copy>
        <span class="label idx" data-reveal>§ 03</span>
        <h2 id="graph-preview-title" data-reveal>{t('home.graph')}</h2>
        <p class="lead" data-reveal>{t('home.graph.lead')}</p>
        <dl class="stats" data-reveal>
          <div><dt>{t('graph.stat.notes')}</dt><dd data-count={stats.notes} style={`--d:${String(stats.notes).length}`}>{stats.notes}</dd></div>
          <div><dt>{t('graph.stat.links')}</dt><dd data-count={stats.links} style={`--d:${String(stats.links).length}`}>{stats.links}</dd></div>
          <div><dt>{t('graph.stat.fields')}</dt><dd data-count={stats.fields} style={`--d:${String(stats.fields).length}`}>{stats.fields}</dd></div>
        </dl>
        <ul class="domains" data-reveal>
          {taxonomy.map((d) => (
            <li><strong>{d.name}</strong><span>{d.fields}</span></li>
          ))}
        </ul>
        <a class="btn btn-primary" href={href('/graph/', lang)} data-reveal>
          <Icon name="graph" />
          {t('home.graph.cta')}
        </a>
      </div>
    </div>
  </section>

  <section class="section wrap notes-block">
    <SectionHead
      index="04"
      title={t('home.notes')}
      link={{ href: href('/notes/', lang), label: t('home.notes.all') }}
    />
    <ul class="note-list">
      {recent.map((note, i) => (
        <NoteRow note={note} lang={lang} crumb={crumbOf(note.domain, note.field)} i={i} />
      ))}
    </ul>
  </section>
</Base>

<script>
  import { initPreview } from '../../scripts/graph/embed';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-graph-preview]');
  if (canvas) initPreview(canvas);
</script>

<style>
  /* --- Hero --- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(100dvh, 960px);
    padding-top: calc(var(--nav-h) + 64px);
    padding-bottom: 72px;
    isolation: isolate;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(70% 70% at 84% 22%, var(--haze), transparent 70%);
  }
  .landscape {
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    width: 100%;
    height: 78%;
    overflow: hidden;
    opacity: 0;
    transition: opacity 1.6s var(--ease);
  }
  /* A static gradient on top: a CSS mask would be re-applied on every composited frame. */
  .landscape::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 20%;
    background: linear-gradient(transparent, var(--paper));
    pointer-events: none;
  }
  .landscape:global(.is-ready) { opacity: 1; }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
  }
  .eyebrow { display: flex; align-items: center; gap: 10px; }
  .tick { width: 26px; height: 1px; background: var(--ink-4); }

  h1 {
    margin-top: 20px;
    margin-left: -0.05em;
    font-size: var(--fs-hero);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.055em;
  }
  h1 span {
    display: inline-block;
    animation: ink-in 0.9s var(--ease) both;
    animation-delay: calc(120ms + var(--i) * 70ms);
  }
  @keyframes ink-in {
    from { opacity: 0; filter: blur(10px); transform: translateY(10px); }
  }

  .role {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    margin-top: 22px;
    font-size: var(--fs-lg);
    color: var(--ink-2);
  }
  .role strong { font-family: var(--font-display); font-weight: 600; color: var(--ink); }
  .tagline {
    margin-top: 18px;
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  :global(:lang(zh)) .tagline { letter-spacing: 0; line-height: 1.55; }
  .intro { margin-top: 12px; max-width: 54ch; color: var(--ink-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }

  /* A scroll cue: a single drop running down a hairline, a few times, then rest. */
  .cue {
    position: absolute;
    right: 0;
    bottom: 26px;
    left: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: cue-in 1s var(--ease) 1.4s both;
  }
  .cue .label { font-size: 0.625rem; }
  .cue-line {
    position: relative;
    width: 1px;
    height: 34px;
    overflow: hidden;
    background: var(--line-2);
  }
  .cue-dot {
    position: absolute;
    top: 0;
    left: -1px;
    width: 3px;
    height: 10px;
    border-radius: 2px;
    background: var(--ink-3);
    animation: cue-run 2.4s var(--ease-in-out) 2s 6 both;
  }
  @keyframes cue-in { from { opacity: 0; } }
  @keyframes cue-run {
    0% { transform: translateY(-12px); opacity: 0; }
    30% { opacity: 1; }
    100% { transform: translateY(36px); opacity: 0; }
  }

  /* --- Dossier --- */
  .dossier {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(40px, 7vw, 104px);
    padding-top: clamp(40px, 5vw, 72px);
  }
  .interests ol { margin-top: 18px; }
  .interests li {
    display: grid;
    grid-template-columns: 44px 1fr;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .interests .num { padding-top: 3px; color: var(--ink-3); }
  .interests h2 { font-size: var(--fs-lg); letter-spacing: -0.012em; }
  .interests p { font-size: var(--fs-sm); color: var(--ink-3); }

  .philosophy { position: sticky; top: calc(var(--nav-h) + 40px); align-self: start; }
  .statement {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.024em;
    color: var(--ink);
  }
  :global(:lang(zh)) .statement { letter-spacing: 0; line-height: 1.6; }

  /* --- Projects --- */
  .project-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 16px;
  }
  .project-grid > :global(.project) { min-height: 400px; }

  /* --- Graph band --- */
  .graph-band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .band-canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s var(--ease);
    touch-action: pan-y;
  }
  .band-canvas:global(.is-ready) { opacity: 1; }
  .graph-band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(90deg, #0e1014 12%, rgb(14 16 20 / 0.72) 34%, transparent 58%);
    pointer-events: none;
  }
  .band-grid { position: relative; z-index: 1; pointer-events: none; }
  .band-copy {
    max-width: 400px;
    padding-block: clamp(64px, 9vw, 120px);
    pointer-events: auto;
  }
  .band-copy .idx { color: var(--ink-3); }
  .band-copy h2 { margin-top: 10px; font-size: var(--fs-3xl); letter-spacing: -0.035em; }
  :global(:lang(zh)) .band-copy h2 { letter-spacing: 0; }
  .band-copy .lead { margin-top: 14px; color: var(--ink-2); }
  .stats { display: flex; gap: 32px; margin-top: 28px; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dd {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .stats dt { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--ink-3); }
  .domains { margin-block: 22px 26px; }
  .domains li {
    display: grid;
    gap: 1px;
    padding: 8px 0;
    border-top: 1px solid var(--line);
    font-size: var(--fs-xs);
    line-height: 1.55;
    color: var(--ink-3);
  }
  .domains strong { font-size: var(--fs-sm); font-weight: 500; color: var(--ink); }

  .notes-block { padding-top: var(--section); }
  .note-list { border-bottom: 1px solid var(--line); }

  @media (max-width: 980px) {
    .project-grid { grid-template-columns: 1fr 1fr; }
    .project-grid > :global(:first-child) { grid-column: 1 / -1; }
  }
  @media (max-width: 820px) {
    .hero { min-height: 0; padding-top: calc(var(--nav-h) + 56px); }
    .hero-grid { grid-template-columns: 1fr; }
    .cue { display: none; }
    .dossier { grid-template-columns: 1fr; }
    .philosophy { position: static; }
    .landscape { height: 54%; }
    .graph-band::after {
      background: linear-gradient(180deg, rgb(14 16 20 / 0.94) 56%, rgb(14 16 20 / 0.5) 82%, transparent);
    }
    .band-copy { max-width: none; padding-bottom: 260px; }
  }
  @media (max-width: 560px) {
    .project-grid { grid-template-columns: 1fr; }
  }
</style>
