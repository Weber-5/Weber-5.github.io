---
import 'katex/dist/katex.min.css';
import '../../../styles/prose.css';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { formatDate, href, localeParams, useT, type Lang, type UiKey } from '../../../i18n';
import { getVault } from '../../../lib/vault';
import { getNotePages, localizeHtml, noteSummary, noteTitle, readingMinutes } from '../../../lib/notes';
import { buildGraph } from '../../../lib/graph';

export async function getStaticPaths() {
  const paths = [];
  for (const { params, props } of localeParams()) {
    for (const page of await getNotePages(props.lang)) {
      paths.push({ params: { ...params, slug: page.note.slug }, props: { ...props, page } });
    }
  }
  return paths;
}

const { page } = Astro.props;
const lang = Astro.props.lang as Lang;
const t = useT(lang);
const { note, entry, bodyLang } = page;

const title = noteTitle(note, lang);
const html = localizeHtml(entry.rendered?.html ?? '', lang);
const headings = (entry.rendered?.metadata?.headings ?? [])
  .filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label')
  .map((h) => ({ ...h, text: h.text.replace(/#$/, '').trim() }));

const backlinks = getVault().backlinks(note.slug);
const { domains } = await buildGraph();
const domain = domains.find((d) => d.id === note.domain);
const field = domain?.fields.find((f) => f.id === note.field);
const crumb = [domain?.name[lang], field?.name[lang]].filter(Boolean);
const mismatch = bodyLang !== lang && note.words > 30;
---

<Base lang={lang} title={title} description={noteSummary(note, lang)} type="article">
  <div class="note" data-note-page data-lang={lang}>
    <div class="progress" aria-hidden="true"><span data-progress></span></div>

    <div class="wrap layout">
      <aside class="toc-rail">
        {headings.length > 0 && (
          <nav class="toc" data-toc aria-label={t('notes.contents')}>
            <p class="label">{t('notes.contents')}</p>
            <ol>
              {headings.map((h) => (
                <li data-depth={h.depth}><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </aside>

      <article data-article>
        <header>
          <p class="crumb">
            <a href={href('/notes/', lang)}>{t('nav.notes')}</a>
            {crumb.map((c) => <span>{c}</span>)}
          </p>
          <h1>{title}</h1>
          <p class="meta label">
            <span>{t('notes.created')} <time datetime={note.created}>{formatDate(note.created, lang)}</time></span>
            {note.updated && <span>{t('notes.updated')} <time datetime={note.updated}>{formatDate(note.updated, lang)}</time></span>}
            <span>{readingMinutes(note)} {t('notes.minutes')}</span>
            <span class="status" data-status={note.status}>{t(`status.${note.status}` as UiKey)}</span>
          </p>
          {mismatch && <p class="lang-note">{t('notes.other')}</p>}
        </header>
        <div class="prose" lang={bodyLang === 'zh' ? 'zh-CN' : 'en'} set:html={html} />
      </article>

      <aside class="side">
        <section>
          <p class="label">{t('notes.neighborhood')}</p>
          <canvas class="local" data-graph-local data-lang={lang} data-focus={note.slug} role="img" aria-label={t('notes.neighborhood')}></canvas>
          <a class="text-link" href={`${href('/graph/', lang)}#node=${encodeURIComponent(note.slug)}`}>
            {t('notes.inGraph')}
            <Icon name="arrow" />
          </a>
        </section>
        {backlinks.length > 0 && (
          <section>
            <p class="label">{t('notes.backlinks')}</p>
            <ul class="backlinks">
              {backlinks.map((b) => (
                <li><a href={href(`/notes/${b.slug}/`, lang)}>{noteTitle(b, lang)}</a></li>
              ))}
            </ul>
          </section>
        )}
        {note.tags.length > 0 && (
          <section>
            <p class="label">{t('notes.tags')}</p>
            <div class="tags">
              {note.tags.map((tag) => (
                <a class="chip" href={href(`/notes/tags/${encodeURIComponent(tag)}/`, lang)}>#{tag}</a>
              ))}
            </div>
          </section>
        )}
      </aside>
    </div>
  </div>
</Base>

<script>
  import { initNotePage } from '../../../scripts/note-page';
  import { initLocal } from '../../../scripts/graph/embed';
  const root = document.querySelector<HTMLElement>('[data-note-page]');
  if (root) initNotePage(root);
  const canvas = document.querySelector<HTMLCanvasElement>('[data-graph-local]');
  if (canvas) initLocal(canvas);
</script>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 110;
    height: 2px;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: left;
  }

  .layout {
    display: grid;
    grid-template-columns: 196px minmax(0, 68ch) 244px;
    justify-content: space-between;
    gap: clamp(24px, 4vw, 56px);
    padding-top: calc(var(--nav-h) + clamp(56px, 7vw, 96px));
  }

  .toc-rail { min-width: 0; }
  .toc { position: sticky; top: calc(var(--nav-h) + 44px); }
  .toc ol { margin-top: 10px; border-left: 1px solid var(--line); }
  .toc a {
    position: relative;
    display: block;
    padding: 4px 0 4px 12px;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--ink-3);
    transition: color var(--t-fast);
  }
  .toc li[data-depth='3'] a { padding-left: 24px; }
  .toc a:hover { color: var(--ink); }
  .toc a:global(.is-active) { color: var(--blue); font-weight: 500; }
  .toc a:global(.is-active)::before {
    content: '';
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: -1px;
    width: 1px;
    background: var(--blue);
  }

  header { margin-bottom: 36px; }
  .crumb { display: flex; flex-wrap: wrap; gap: 8px; font-size: var(--fs-xs); color: var(--ink-3); }
  .crumb a:hover { color: var(--blue); }
  .crumb span::before { content: '/'; margin-right: 8px; color: var(--ink-4); }
  h1 {
    margin-top: 12px;
    font-size: clamp(2rem, 1.5rem + 2vw, 2.875rem);
    letter-spacing: -0.032em;
  }
  :global(:lang(zh)) h1 { letter-spacing: 0; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin-top: 16px;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    text-transform: none;
  }
  .status { display: inline-flex; align-items: center; gap: 5px; }
  .status::before {
    content: '';
    width: 7px;
    height: 7px;
    border: 1px solid var(--ink-3);
    border-radius: 50%;
  }
  .status[data-status='growing']::before { background: linear-gradient(90deg, var(--ink-3) 50%, transparent 50%); }
  .status[data-status='evergreen']::before { background: var(--blue); border-color: var(--blue); }
  .lang-note {
    margin-top: 16px;
    padding: 8px 12px;
    border: 1px dashed var(--line-2);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }

  .side { position: sticky; top: calc(var(--nav-h) + 44px); align-self: start; display: grid; gap: 26px; }
  .local {
    display: block;
    width: 100%;
    height: 210px;
    margin-block: 10px 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    opacity: 0;
    transition: opacity 700ms var(--ease);
    touch-action: pan-y;
  }
  .local:global(.is-ready) { opacity: 1; }
  .backlinks { margin-top: 8px; }
  .backlinks li { border-top: 1px solid var(--line); }
  .backlinks a {
    display: block;
    padding: 6px 0;
    font-size: var(--fs-sm);
    color: var(--ink-2);
    transition: color var(--t-fast), padding-left var(--t-fast);
  }
  .backlinks a:hover { padding-left: 4px; color: var(--blue); }
  .tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }

  @media (max-width: 1180px) {
    .layout { grid-template-columns: minmax(0, 68ch) 244px; }
    .toc-rail { display: none; }
  }
  @media (max-width: 880px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; margin-top: 40px; }
  }
</style>
