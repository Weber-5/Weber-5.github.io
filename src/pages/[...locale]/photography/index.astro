---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import PhotoTile from '../../../components/PhotoTile.astro';
import { categoryName, localeParams, useT, type Lang } from '../../../i18n';
import { getProfile } from '../../../lib/data';
import { getPhotos } from '../../../lib/photos';

export const getStaticPaths = localeParams;

const lang = Astro.props.lang as Lang;
const t = useT(lang);
const profile = getProfile();
const photos = await getPhotos();
const categories = [...new Set(photos.map((p) => p.category))].map((id) => ({
  id,
  name: categoryName(id, lang),
  count: photos.filter((p) => p.category === id).length,
}));
const strings = { of: t('photos.of') };
---

<Base lang={lang} title={t('photos.title')} description={t('photos.lead')}>
  <header class="page-head wrap">
    <h1 data-reveal>{t('photos.title')}</h1>
    <p class="lead" data-reveal style="--i:1">{t('photos.lead')}</p>
    {profile.links.px500 && (
      <div class="elsewhere" data-reveal style="--i:2">
        <a class="btn" href={profile.links.px500} rel="me noopener">
          <Icon name="camera" />
          {t('photos.more')}
        </a>
      </div>
    )}
  </header>

  <section class="wrap" data-gallery data-strings={JSON.stringify(strings)}>
    {categories.length > 1 && (
      <div class="filters" role="group" aria-label={t('photos.title')} data-reveal>
        <button class="filter" type="button" data-photo-filter="" aria-pressed="true">
          {t('research.filter.all')} <span class="n">{photos.length}</span>
        </button>
        {categories.map((c) => (
          <button class="filter" type="button" data-photo-filter={c.id} aria-pressed="false">
            {c.name} <span class="n">{c.count}</span>
          </button>
        ))}
      </div>
    )}
    <div class="gallery">
      {photos.map((photo, i) => <PhotoTile photo={photo} lang={lang} i={i % 6} />)}
    </div>
  </section>

  <dialog class="viewer" data-viewer aria-label={t('photos.title')}>
    <div class="stage" data-v-stage></div>
    <aside class="info">
      <p class="label count" data-v-count></p>
      <h2 data-v-title></h2>
      <p class="place" data-v-place></p>
      <p class="caption" data-v-caption></p>
      <dl data-v-rows></dl>
    </aside>
    <button class="nav prev" type="button" data-v-prev aria-label={t('photos.prev')}><Icon name="arrow" /></button>
    <button class="nav next" type="button" data-v-next aria-label={t('photos.next')}><Icon name="arrow" /></button>
    <button class="close" type="button" data-v-close aria-label={t('graph.close')}><Icon name="close" /></button>
  </dialog>
</Base>

<script>
  import { initGallery } from '../../../scripts/gallery';
  const root = document.querySelector<HTMLElement>('[data-gallery]');
  const viewer = document.querySelector<HTMLDialogElement>('[data-viewer]');
  if (root && viewer) initGallery(root, viewer);
</script>

<style>
  .elsewhere { margin-top: 22px; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 22px; }
  .n { font-family: var(--font-mono); font-size: 0.6875rem; opacity: 0.6; }
  .gallery {
    --row: 260px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  /* Keeps the last row from stretching a lone photo across the page. */
  .gallery::after { content: ''; flex: 999 1 0; }
  .gallery :global([hidden]) { display: none; }
  @media (max-width: 640px) {
    .gallery { --row: 150px; gap: 6px; }
  }

  /* --- Viewer: photographs are seen best against near-black, in either theme --- */
  .viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color-scheme: dark;
    background: #07080a;
    color: #e6e9ee;
  }
  .viewer[open] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    animation: viewer-in 260ms var(--ease);
  }
  .viewer::backdrop { background: #07080a; }
  @keyframes viewer-in { from { opacity: 0; } }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 0;
    padding: 4vh 72px;
    touch-action: pan-y;
  }
  .stage :global(.frame) {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  .stage :global(img), .stage :global(.ph) {
    max-width: 100%;
    max-height: 92vh;
    border-radius: 3px;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.8);
    transition: opacity 400ms var(--ease);
  }
  .stage :global(.ph) { width: min(100%, calc(92vh * var(--r))); aspect-ratio: var(--r); overflow: hidden; }

  .info {
    overflow-y: auto;
    padding: 72px 28px 32px;
    border-left: 1px solid rgb(255 255 255 / 0.07);
  }
  .count { color: #8f97a3; }
  .info h2 { margin-top: 10px; font-size: var(--fs-xl); letter-spacing: -0.02em; color: #f1f3f6; }
  .place { margin-top: 4px; font-size: var(--fs-sm); color: #a9b1bc; }
  .caption { margin-top: 14px; font-size: var(--fs-sm); line-height: 1.6; color: #c6ccd5; }
  .caption:empty, .place:empty { display: none; }
  .info dl { margin-top: 22px; }
  .info :global(dl > div) {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    padding: 7px 0;
    border-top: 1px solid rgb(255 255 255 / 0.07);
    font-size: var(--fs-xs);
  }
  .info :global(dt) { font-family: var(--font-mono); color: #8f97a3; letter-spacing: 0.03em; }
  .info :global(dd) { color: #dfe3e9; }

  .nav, .close {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #c6ccd5;
    transition: background-color var(--t-fast), color var(--t-fast), transform var(--t-fast) var(--ease);
  }
  .nav:hover, .close:hover { background: rgb(255 255 255 / 0.08); color: #fff; }
  .nav:active, .close:active { transform: scale(0.92); }
  .nav :global(svg), .close :global(svg) { width: 20px; height: 20px; }
  .nav { top: 50%; margin-top: -22px; }
  .prev { left: 14px; }
  .prev :global(svg) { transform: rotate(180deg); }
  .next { right: calc(320px + 14px); }
  .close { top: 14px; right: 14px; }
  .nav[disabled] { opacity: 0.25; pointer-events: none; }

  @media (max-width: 900px) {
    .viewer[open] { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) auto; }
    .stage { padding: 56px 12px 12px; }
    .stage :global(img) { max-height: 64vh; }
    .stage :global(.ph) { width: min(100%, calc(64vh * var(--r))); }
    .info { max-height: 36vh; padding: 16px 20px 24px; border-left: 0; border-top: 1px solid rgb(255 255 255 / 0.07); }
    .info h2 { margin-top: 4px; }
    .nav { display: none; }
  }
</style>
